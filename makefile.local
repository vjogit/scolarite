# ── Espace de travail « local » ────────────────────────────────────────────────
# Chaîne de déploiement sur poste de développement. Le pendant production est
# makefile.prod. Le makefile racine n'inclut qu'un seul des deux fragments.

DOCKER_DIR=infra/container
INFRA_DIR=infra
BACK_DIR=back
RUN_DIR=infra/run
KEYCLOAK_DIR=infra/keycloak
LIQUIBASE_DIR=infra/liquibase

# Le fichier de secrets n'est pas versionné (.gitignore : infra/env/secrets-*.env).
# Sans ce garde-fou, make se contenterait d'un « No such file or directory ».
ifeq ($(wildcard $(SECRETS_FILE_LOCAL)),)
$(error Fichier de secrets absent : $(SECRETS_FILE_LOCAL) — le créer à partir de $(ENV_DIR)/secrets.env.example)
endif

include $(CONFIG_FILE_LOCAL)
include $(SECRETS_FILE_LOCAL)
export

.PHONY: start-local-reset start-local-keep start-dev start-dev-reset restart-local-keep reset-db _purge _pg-up _keycloak-down _keycloak-up _mailpit-up keycloak liquibase gen_sql start-scolarite stop-local restart-local-reset clean clean-local



start-local-reset: _purge _pg-up _mailpit-up _keycloak-down reset-db _keycloak-up keycloak liquibase gen_sql start-scolarite _sleep
	@echo "--- ✅ Infra locale démarrée (BD recréée) ---"

start-local-keep: _pg-up _mailpit-up _keycloak-up keycloak liquibase gen_sql start-scolarite
	@echo "--- ✅ Infra locale démarrée (BD conservée) ---"

# Espace de travail « dev » : tout ce dont le poste a besoin pour travailler
# hors conteneur, et rien de plus. Même chaîne que start-local-keep, privée de
# start-scolarite : le backend est lancé par le debugger VSCode (configuration
# « Debug scolarite », qui lit infra/env/*.env) et le front par `npm run dev`
# en mode development. Construire les images backend et nginx ne servirait à
# rien ici, et le nginx du conteneur servirait un build figé au lieu du serveur
# Vite.
#
# start-dev conserve la base, start-dev-reset la recrée — même partage qu'entre
# start-local-keep et start-local-reset.
start-dev: _pg-up _mailpit-up _keycloak-up keycloak liquibase gen_sql
	@echo "--- ✅ Infra de développement démarrée (BD conservée) ---"

# Pendant « reset » de start-dev. Reprend start-local-reset sans
# start-scolarite, et sans le _sleep final qui n'y servait qu'à laisser les
# conteneurs applicatifs se poser avant l'annonce de succès.
start-dev-reset: _purge _pg-up _mailpit-up _keycloak-down reset-db _keycloak-up keycloak liquibase gen_sql
	@echo "--- ✅ Infra de développement démarrée (BD recréée) ---"

restart-local-reset: stop-local _sleep start-local-reset

restart-local-keep: stop-local _sleep start-local-keep

_sleep:
	sleep 5

# Rase l'infra locale : conteneurs, réseaux et volumes de données.
#
# Ciblage par projet et non par fichier : c'est le seul moyen d'atteindre une
# stack lancée depuis un compose.yaml depuis déplacé ou supprimé, dont les
# conteneurs continuent de tourner. La commande sort en 0 si rien ne
# correspond, elle est donc sans effet sur une machine déjà propre.
#
# --remove-orphans est indispensable : « scolarite » ne déclare plus que
# backend et nginx, les conteneurs db et keycloak d'une ancienne disposition
# survivraient et retiendraient le réseau 10.20.2.0/24, que
# infra/container/compose.yaml redemande à l'identique (les services y ont des
# IP statiques, le sous-réseau ne peut pas flotter).
#
# Ordre imposé : « scolarite » attache le réseau en external, il doit partir
# avant « infra-scolarite » qui le possède.
_purge:
	@echo "--- 🧹 Purge de l'infra locale (conteneurs, réseaux, volumes) ---"
	docker compose -p scolarite down -v --remove-orphans
	docker compose -p infra-scolarite down -v --remove-orphans

_pg-up:
	@echo "--- 🐳 Démarrage de PostgreSQL ---"
	cd $(DOCKER_DIR) && docker compose -f compose.yaml --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) up -d --wait db

reset-db:
	$(INFRA_DIR)/reset-db.sh $(CONFIG_FILE_LOCAL) $(SECRETS_FILE_LOCAL)

# [DEV-LOCAL] Mailpit : SMTP factice requis par le parcours de création de
# compte (courriel UPDATE_PASSWORD). Arrêt et purge couverts par stop-local
# et _purge, qui agissent sur toute la composition. Pas d'équivalent dans
# makefile.prod : la prod parle à un vrai relais.
_mailpit-up:
	@echo "--- 📬 Démarrage de Mailpit ---"
	cd $(DOCKER_DIR) && docker compose -f compose.yaml --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) up -d mail-service

_keycloak-down:
	@echo "--- 🛑 Arrêt de Keycloak ---"
	cd $(DOCKER_DIR) && docker compose -f compose.yaml --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) stop auth-service

_keycloak-up:
	@echo "--- 🐳 Démarrage de Keycloak ---"
	cd $(DOCKER_DIR) && docker compose -f compose.yaml --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) up -d auth-service
	@echo "--- ⏳ Attente de la disponibilité de Keycloak ---"
	$(DOCKER_DIR)/wait_for_keycloak.sh http://$(KC_INTERNAL_HOSTNAME):8080$(KC_HTTP_RELATIVE_PATH)/realms/master/protocol/openid-connect/certs

keycloak: _keycloak-up
	$(KEYCLOAK_DIR)/deploy.sh $(CONFIG_FILE_LOCAL) $(SECRETS_FILE_LOCAL)

liquibase:
	$(LIQUIBASE_DIR)/migrate.sh $(CONFIG_FILE_LOCAL) $(SECRETS_FILE_LOCAL)

gen_sql:
	@echo "--- 🆕 gen code sqlc ---"
	$(INFRA_DIR)/gen_sql.sh $(CONFIG_FILE_LOCAL) $(SECRETS_FILE_LOCAL)

start-scolarite : 
	$(RUN_DIR)/build-scolarite.sh local
	$(RUN_DIR)/start-scolarite.sh local

# Ordre inversé par rapport à la version d'origine : backend et nginx
# attachent le réseau en external, ils doivent partir avant les conteneurs qui
# le possèdent. Pas de -v ici, start-local-keep s'appuie sur le volume.
stop-local:
	@echo "--- 🛑 Arrêt de l'application scolarite ---"
	CONFIG_FILE=$(abspath $(CONFIG_FILE_LOCAL)) SECRETS_FILE=$(abspath $(SECRETS_FILE_LOCAL)) docker compose -f $(RUN_DIR)/compose.yaml down --remove-orphans
	@echo "--- 🛑 Arrêt des conteneurs Docker ---"
	cd $(DOCKER_DIR) && docker compose -f compose.yaml --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) down --remove-orphans

# Arrêt et suppression des conteneurs, volumes conservés.
# « clean » reste un alias : c'était le nom de la cible avant la séparation
# des espaces de travail.
clean: clean-local

clean-local:
	cd $(DOCKER_DIR) && docker compose --env-file ../../$(CONFIG_FILE_LOCAL) --env-file ../../$(SECRETS_FILE_LOCAL) down
