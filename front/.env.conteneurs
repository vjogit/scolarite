# Mode « conteneurs » : le front est construit puis servi par nginx
# (infra/run/build/Dockerfile, target nginx), qui reverse-proxie /api vers le
# conteneur backend et /auth vers Keycloak. Les URL sont donc celles de nginx.
#
# Ce mode ne peut pas s'appeler « local » : Vite refuse ce nom, il entrerait en
# conflit avec le suffixe .local des fichiers d'env.
#
# Bâti par : infra/run/start-scolarite.sh local
VITE_API_URL=https://10.20.2.5:9021
VITE_KEYCLOAK_URL=https://10.20.2.5:9021/auth
VITE_KEYCLOAK_REALM=RealmCybScolarite
VITE_KEYCLOAK_CLIENT_ID=spa-app
