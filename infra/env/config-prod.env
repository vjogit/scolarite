# Topologie « prod » — aucun secret ici.
#
# Adresses, ports, noms de bases, identifiants, noms de clients Keycloak.
# VERSIONNÉ, comme la variante locale : mettre les changements de serveur ou de
# nom sous revue vaut mieux que de les cacher, et rien ici ne se révoque.
# Voir infra/env/README.md.
#
# Les valeurs sont encore des PLACEHOLDERS calqués sur le local : la chaîne
# prod reprend celle de développement (makefile.prod est une copie de
# makefile.local). À renseigner avant le premier déploiement réel.

# ── Environnement ───────────────────────────────────────────────────────────────
# Nom de l'espace de travail. Alimente TF_VAR_environnement, que keycloak.tf
# confronte à l'espace de travail Terraform sélectionné.
SCOLARITE_ENV=prod

# Répertoire hôte où start-scolarite.sh dépose le config.yaml monté dans le
# conteneur backend (voir infra/run/compose.yaml).
SCOLARITE_CONF_DIR=/home/vjo/.scolarite/conf-prod

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
# Nom du conteneur, fixé par infra/container/compose.yaml. Les scripts qui
# parlent à la base par `docker exec` (reset-db.sh, gen_sql.sh) le lisent ici.
PG_CONTAINER=postgres-16.10-alpine
POSTGRES_HOST=10.20.2.3
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres

SCOLARITE_DB=scolarite
SCOLARITE_USER=scolarite

# ── Keycloak — service ──────────────────────────────────────────────────────────
KC_DB=postgres
KC_DB_NAME=keycloak
KC_DB_URL=jdbc:postgresql://db:${POSTGRES_PORT}/${KC_DB_NAME}
KC_DB_USERNAME=keycloak
KC_HOSTNAME=https://10.20.2.5:9021/auth
KC_INTERNAL_HOSTNAME=10.20.2.2
KC_HTTP_RELATIVE_PATH=/auth

KEYCLOAK_ADMIN=admin

# ── Keycloak — realm (source unique du module Terraform) ────────────────────────
# Il n'y a pas de .tfvars : les makefiles dérivent les TF_VAR_* de ces noms-ci.
KC_REALM=RealmCybScolarite
KC_CLIENT_ID=spa-app
KC_BACKEND_CLIENT_ID=backend-api

# Origines autorisées du client SPA, séparées par des virgules (le module fait
# le split). Une seule en prod : nginx. Pas de Vite, pas de localhost.
KC_FRONTEND_URLS=https://10.20.2.5:9021

# Relais SMTP réel. Laisser KC_SMTP_USER vide si le relais n'authentifie pas :
# aucune authentification n'est alors tentée.
KC_SMTP_HOST=smtp.example.org
KC_SMTP_PORT=587
KC_SMTP_FROM=no-reply@example.org
KC_SMTP_FROM_DISPLAY_NAME="Scolarité"
KC_SMTP_STARTTLS=true
KC_SMTP_SSL=false
KC_SMTP_USER=

# Compte de démarrage : uniquement le temps d'amorcer le realm. Une fois les
# vrais administrateurs créés, repasser à false et vider
# KC_BOOTSTRAP_USER_PASSWORD — le prochain apply supprimera le compte.
KC_BOOTSTRAP_USER_ENABLED=true
KC_BOOTSTRAP_USER_USERNAME=admin-demarrage
KC_BOOTSTRAP_USER_EMAIL=no-reply@example.org
# Changement imposé au premier login : ce mot de passe a transité par un
# fichier, et souvent par une conversation. Il ne doit pas survivre à l'amorçage.
KC_BOOTSTRAP_USER_PASSWORD_TEMPORARY=true
