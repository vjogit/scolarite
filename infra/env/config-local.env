# Topologie « local » — aucun secret ici.
#
# Adresses, ports, noms de bases, identifiants, noms de clients Keycloak.
# Séparé des secrets pour que ces derniers restent peu nombreux et lisibles.
# VERSIONNÉ : ce fichier décrit le réseau docker de développement (voir
# infra/container/compose.yaml) et permet de démarrer sans rien deviner.
# Seuls les secrets restent à renseigner. Voir infra/env/README.md.

# ── Environnement ───────────────────────────────────────────────────────────────
# Nom de l'espace de travail. Alimente TF_VAR_environnement, que keycloak.tf
# confronte à l'espace de travail Terraform sélectionné.
SCOLARITE_ENV=local

# Répertoire hôte où start-scolarite.sh dépose le config.yaml monté dans le
# conteneur backend (voir infra/run/compose.yaml).
SCOLARITE_CONF_DIR=/home/vjo/.scolarite/conf

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
# Nom du conteneur, fixé par infra/container/compose.yaml. Les scripts qui
# parlent à la base par `docker exec` (reset-db.sh, gen_sql.sh) le lisent ici.
PG_CONTAINER=postgres-16.10-alpine
POSTGRES_HOST=10.20.2.3
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres

SCOLARITE_DB=scolarite
SCOLARITE_USER=scolarite

# ── Keycloak — service ──────────────────────────────────────────────────────────
KC_DB=postgres
KC_DB_NAME=keycloak
KC_DB_URL=jdbc:postgresql://db:${POSTGRES_PORT}/${KC_DB_NAME}
KC_DB_USERNAME=keycloak
# Issuer OIDC attendu par le backend. Il doit désigner la porte d'entrée par
# laquelle le NAVIGATEUR a obtenu son jeton, sinon la revendication « iss » ne
# correspond pas — Keycloak est en hostname dynamique et annonce l'adresse par
# laquelle on l'atteint. Or l'espace de travail local couvre deux portes :
#
#   * hors conteneur (debugger VSCode + `npm run dev`) : le serveur Vite ;
#   * en conteneur (`make start-local-keep`) : nginx.
#
# KC_HOSTNAME porte la première — c'est la valeur que lit le debugger, qui
# source ce fichier directement. start-scolarite.sh lui substitue la seconde
# avant de rendre le config.yaml du conteneur.
KC_HOSTNAME=https://10.20.2.1:5173/auth
KC_HOSTNAME_CONTENEURS=https://10.20.2.5:9021/auth
KC_INTERNAL_HOSTNAME=10.20.2.2
KC_HTTP_RELATIVE_PATH=/auth

KEYCLOAK_ADMIN=admin

# ── Keycloak — realm (source unique du module Terraform) ────────────────────────
# Il n'y a pas de .tfvars : les makefiles dérivent les TF_VAR_* de ces noms-ci.
KC_REALM=RealmCybScolarite
KC_CLIENT_ID=spa-app
KC_BACKEND_CLIENT_ID=backend-api

# Origines autorisées du client SPA, séparées par des virgules (le module fait
# le split). Trois entrées en local : Vite vu du bridge docker, Vite vu du
# navigateur, et nginx.
KC_FRONTEND_URLS=https://10.20.2.1:5173,https://localhost:5173,https://10.20.2.5:9021

# [DEV-LOCAL] Relais SMTP du realm : Mailpit capte tout et ne délivre rien.
# Ni authentification (KC_SMTP_USER vide), ni TLS. Interface web sur
# http://localhost:8025.
KC_SMTP_HOST=10.20.2.6
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@scolarite.local
KC_SMTP_FROM_DISPLAY_NAME="Scolarité (local)"
KC_SMTP_STARTTLS=false
KC_SMTP_SSL=false
KC_SMTP_USER=

# [DEV-LOCAL] Compte de démarrage, rôle ADMIN. Son mot de passe temporaire est
# un secret : voir KC_BOOTSTRAP_USER_PASSWORD dans secrets-local.env.
KC_BOOTSTRAP_USER_ENABLED=true
KC_BOOTSTRAP_USER_USERNAME=foo
KC_BOOTSTRAP_USER_EMAIL=foo@scolarite.local
# [DEV-LOCAL] Pas de changement imposé au premier login : le mot de passe de
# « foo » est public et documenté, le retaper après chaque remise à zéro de la
# base n'apporte rien. En prod, cette variable vaut true.
KC_BOOTSTRAP_USER_PASSWORD_TEMPORARY=false
