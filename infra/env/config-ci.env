# Topologie « CI » — aucun secret ici. VERSIONNÉ.
#
# Jumeau de config-local.env pour l'exécuteur GitHub (.github/workflows/e2e.yml) :
# même réseau Docker, mêmes adresses, mêmes comptes de test — c'est l'espace de
# travail « local » (SCOLARITE_ENV, cible Docker, mode Vite « conteneurs »,
# CA mkcert) sur une autre machine. Seules les lignes marquées [CI] diffèrent
# de config-local.env, et chacune dit pourquoi. Les commentaires détaillés de
# chaque variable vivent dans config-local.env ; ils ne sont pas recopiés.
#
# La CI vérifie à chaque exécution que les deux fichiers déclarent le même
# jeu de variables : une variable ajoutée à l'un sans l'autre arrête le
# workflow avant de monter la stack (envsubst la remplacerait par une chaîne
# vide, sans message — le piège de infra/env/README.md).
#
# Les secrets de la CI (secrets-ci.env) ne sont pas versionnés : le workflow
# les fabrique depuis secrets.env.example avec des valeurs aléatoires, le
# temps du job. Voir docs/ci.md.

# ── Environnement ───────────────────────────────────────────────────────────────
# Reste « local » : keycloak.tf n'accepte que local ou prod (validation de la
# variable environnement), et c'est bien cet espace de travail que la CI
# reproduit. L'état Terraform vit sur l'exécuteur, jeté avec lui.
SCOLARITE_ENV=local

# [CI] Répertoire hôte de la configuration rendue — le compte de l'exécuteur
# GitHub (runner), là où config-local.env porte celui du poste.
SCOLARITE_CONF_DIR=/home/runner/.scolarite/conf

# Niveau debug conservé : les journaux du backend sont publiés en artefact
# d'exécution, c'est là qu'on lit un échec intermittent.
SCOLARITE_LOG_LEVEL=debug

# ── nginx — proxy en amont légitime (real_ip) ────────────────────────────────────
NGINX_TRUSTED_PROXIES=127.0.0.1/32

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
PG_CONTAINER=postgres-16.10-alpine
POSTGRES_HOST=10.20.2.3
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres

SCOLARITE_DB=scolarite
SCOLARITE_USER=scolarite
SCOLARITE_DB_SSLMODE=disable
SCOLARITE_DB_SSLROOTCERT=

# ── Keycloak — service ──────────────────────────────────────────────────────────
KC_DB=postgres
KC_DB_NAME=keycloak
KC_DB_URL=jdbc:postgresql://db:${POSTGRES_PORT}/${KC_DB_NAME}
KC_DB_USERNAME=keycloak
# KC_HOSTNAME désigne le serveur Vite, que la CI ne lance jamais ; conservé
# parce que start-scolarite.sh lui substitue KC_HOSTNAME_CONTENEURS, la seule
# porte d'entrée de la CI (nginx).
KC_HOSTNAME=https://10.20.2.1:5173/auth
KC_HOSTNAME_CONTENEURS=https://10.20.2.5:9021/auth
KC_INTERNAL_HOSTNAME=10.20.2.2
KC_HTTP_RELATIVE_PATH=/auth

KEYCLOAK_ADMIN=admin

# ── Keycloak — realm (source unique du module Terraform) ────────────────────────
KC_REALM=RealmCybScolarite
KC_CLIENT_ID=spa-app
KC_BACKEND_CLIENT_ID=backend-api
KC_FRONTEND_URLS=https://10.20.2.1:5173,https://localhost:5173,https://10.20.2.5:9021

# [DEV-LOCAL] Relais SMTP du realm : Mailpit, monté par la CI comme en local.
KC_SMTP_HOST=10.20.2.6
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@scolarite.local
KC_SMTP_FROM_DISPLAY_NAME="Scolarité (CI)"
KC_SMTP_STARTTLS=false
KC_SMTP_SSL=false
KC_SMTP_USER=

# ── Registre — ancrage TSA et témoin externe ────────────────────────────────────
# [CI] Ancrage désactivé : la CI ne doit dépendre d'aucun service tiers, et le
# certificat racine FreeTSA s'obtient par un acte volontaire
# (`make fetch-freetsa-cert`), jamais par un téléchargement automatique. Le
# chemin reste vide en conséquence. `registre.spec.ts` ne présume pas du
# verdict de la carte Ancrage (« aucune ancre » est une alerte comme une autre).
REGISTRE_ANCRAGE_ENABLED=false
REGISTRE_TSA_CA_CERT=
# Témoin vers Mailpit, comme en local.
REGISTRE_TEMOIN_ENABLED=true
REGISTRE_TEMOIN_RECIPIENT=temoin-registre@scolarite.local
REGISTRE_SMTP_HOST=10.20.2.6
REGISTRE_SMTP_PORT=1025
REGISTRE_SMTP_USER=
REGISTRE_SMTP_FROM=no-reply@scolarite.local
REGISTRE_SMTP_STARTTLS=false

# [DEV-LOCAL] Compte de démarrage, rôle ADMIN — le compte « admin » de la suite.
KC_BOOTSTRAP_USER_ENABLED=true
KC_BOOTSTRAP_USER_USERNAME=foo
KC_BOOTSTRAP_USER_EMAIL=foo@scolarite.local
KC_BOOTSTRAP_USER_PASSWORD_TEMPORARY=false

# ── Keycloak — comptes de test Playwright (front/e2e) ────────────────────────────
TEST_CONSULTATION_USER_ENABLED=true
TEST_CONSULTATION_USER_USERNAME=test-consultation
TEST_CONSULTATION_USER_EMAIL=test-consultation@scolarite.local

TEST_NOTES_ECRITURE_USER_ENABLED=true
TEST_NOTES_ECRITURE_USER_USERNAME=test-notes-ecriture
TEST_NOTES_ECRITURE_USER_EMAIL=test-notes-ecriture@scolarite.local
