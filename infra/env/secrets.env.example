# Gabarit des secrets — VERSIONNÉ, valeurs vides.
#
# Copier en secrets-local.env (et secrets-prod.env pour la production), puis
# renseigner. Ces deux fichiers ne sont jamais versionnés ; celui-ci existe pour
# que la LISTE des secrets attendus, elle, le soit.
#
# Pourquoi cette liste importe : envsubst remplace une variable absente par une
# chaîne VIDE, sans message. Un secret oublié ne se voit pas au démarrage — il
# se voit le jour où l'authentification échoue.
#
# La topologie — adresses, ports, comptes, noms de clients — n'est pas ici :
# voir config-local.env et config-prod.env, versionnés, et README.md.

# ── Bases de données ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
SCOLARITE_PASSWORD=
KC_DB_PASSWORD=

# ── Keycloak — administration ───────────────────────────────────────────────────
# Compte master utilisé par le provider Terraform. Le nom du compte est de la
# topologie (KEYCLOAK_ADMIN), seul le mot de passe est ici.
KEYCLOAK_ADMIN_PASSWORD=

# ── Keycloak — client backend ───────────────────────────────────────────────────
# NE PAS renseigner à la main : la cible keycloak / keycloak-prod le réécrit
# après chaque terraform apply, à partir de la valeur générée par Keycloak.
KC_BACKEND_CLIENT_SECRET=

# ── Keycloak — relais SMTP ──────────────────────────────────────────────────────
# Reste vide tant que KC_SMTP_USER l'est : sans identifiant, aucune
# authentification n'est tentée (cas de Mailpit en local).
KC_SMTP_PASSWORD=

# ── Keycloak — compte de démarrage ──────────────────────────────────────────────
# Mot de passe temporaire du compte amorçant le realm. Keycloak en force le
# remplacement au premier login. Obligatoire tant que
# KC_BOOTSTRAP_USER_ENABLED vaut true — une precondition Terraform refuse
# l'apply s'il est vide.
KC_BOOTSTRAP_USER_PASSWORD=
