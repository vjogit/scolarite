# ── Binaires / compilation ────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
**/__*bin*
**/*.bak

# ── Go ────────────────────────────────────────────────────────────────────────
*.test
*.out
*.coverprofile
coverage.*
profile.cov
go.work
go.work.sum
# vendor/

# ── Frontend ──────────────────────────────────────────────────────────────────
front/.vite/
front/dist/
front/node_modules/

# ── Infrastructure ────────────────────────────────────────────────────────────
infra/data/

# ── Code généré ───────────────────────────────────────────────────────────────
**/gen/

# ── Fichiers de données ───────────────────────────────────────────────────────
back/cmd/programme-import/data/
**/*.xlsx
**/*.docx
**/*.jar
**/*.log

# ── Certificats locaux (générés par mkcert) ───────────────────────────────────
infra/run/build/ssl/
front/cert/

# ── Environnement / secrets ───────────────────────────────────────────────────
.env

# Les secrets ne sont jamais versionnés ; leur LISTE l'est, dans
# infra/env/secrets.env.example, pour qu'un oubli se voie.
infra/env/secrets-*.env
# config-local.env ET config-prod.env sont versionnés : ils ne contiennent
# aucun secret, et la topologie de prod n'a rien à cacher — l'en soustraire
# n'aurait protégé personne tout en privant d'historique les changements
# d'adresse ou de nom de realm.

# ── Éditeurs / IDE ────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Outillage local ───────────────────────────────────────────────────────────
# Captures et journaux déposés par le serveur MCP Playwright
.playwright-mcp/
